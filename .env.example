# Copy to .env. The ONLY required value is ANTHROPIC_API_KEY.
#
# Naming: third-party services keep their conventional variable names, so a key
# you already have exported works with no duplication and the `langsmith` CLI
# reads the same variable this app does. Settings that are genuinely ours are
# prefixed FP_, because `MAX_ATTEMPTS` unprefixed would collide with anything.

# --- required ----------------------------------------------------------------
ANTHROPIC_API_KEY=sk-ant-...

# --- optional: tracing (conventional names; the langsmith CLI reads these too) -
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=feature-pilot
# LANGSMITH_WORKSPACE_ID=            # only for org-scoped service keys

# --- optional: publishing PRs --------------------------------------------------
# Unset => gh's ambient `gh auth login` credential. Set => this token is used
# for issue fetch, fork, push, and PR creation (needs repo + workflow scopes).
# GITHUB_TOKEN=ghp_...

# --- optional: Phase 1B embeddings -------------------------------------------
# Unset => local fastembed (free, offline). Set => voyage-code-3.
# VOYAGE_API_KEY=pa-...

# --- optional: datastores ----------------------------------------------------
# Defaults match docker-compose.yml. Non-standard ports avoid colliding with a
# local postgres/redis.
# DATABASE_URL=postgresql://featurepilot:featurepilot@localhost:5433/featurepilot
# REDIS_URL=redis://localhost:6380/0

# --- optional: Bedrock model routing -------------------------------------------
# Route any role through AWS Bedrock instead of the Anthropic API. Credentials
# come from boto3's chain (env vars, ~/.aws, or an EC2 instance role) — with a
# full-Bedrock configuration ANTHROPIC_API_KEY is not needed at all.
# Requires: uv sync --extra aws
# FP_MODEL_ROUTER=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
# FP_MODEL_PLANNER=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# FP_MODEL_CODER=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# FP_MODEL_CRITIC=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# FP_MODEL_DEBUGGER=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# FP_MODEL_REVIEWER=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# FP_MODEL_SUMMARIZER=bedrock/us.anthropic.claude-haiku-4-5-20251001-v1:0
# No Opus inference profile on this account: escalation retries at the same tier.
# FP_MODEL_ESCALATION=bedrock/us.anthropic.claude-sonnet-4-5-20250929-v1:0
# AWS_REGION=us-east-1

# --- optional: serving a browser frontend --------------------------------------
# Origins allowed to read the API from a browser. Without the frontend's own
# origin here, it can start a run and then be unable to read its event stream.
# FP_API_CORS_ORIGINS=http://localhost:5173,https://your-frontend.pages.dev
#
# Set false on anything publicly reachable: it restricts runs to public issue
# URLs, so nobody can point the agent at a path on the server.
# FP_ALLOW_LOCAL_REPOS=true
#
# Each concurrent run holds a sandbox of FP_SANDBOX_MEMORY, so concurrency is a
# memory ceiling. Runs past it queue; past the queue they are refused (503).
# FP_MAX_CONCURRENT_RUNS=2
# FP_MAX_QUEUED_RUNS=8
#
# Ceiling on what runs using THIS server's key may spend per day. A visitor who
# supplies their own key in the frontend's modal is spending their own money and
# is not counted against it.
# FP_MAX_USD_PER_DAY=5.00

# --- optional: ours, hence prefixed ------------------------------------------
# FP_MODEL_PLANNER=anthropic/claude-sonnet-5
# FP_MODEL_CODER=anthropic/claude-sonnet-5
# FP_MODEL_ESCALATION=anthropic/claude-opus-5
# FP_MAX_ATTEMPTS=3
# FP_MAX_USD_PER_RUN=2.00
# FP_RETRIEVER=filesystem          # 1B flips this to "hybrid"
# FP_SANDBOX_MEMORY=2g
